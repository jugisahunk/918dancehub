---
import '../styles/global.css';
import { site } from '../data/site';
import { venue } from '../data/venue';
import { buildLocalBusinessJsonLd } from '../data/structured-data';
import { isGateActive } from '../data/gate';

interface Props {
  title?: string;
  description?: string;
  // Coming Soon Gate splash (issue #38) has no business content to
  // describe, so it skips the LocalBusiness JSON-LD block emitted on every
  // other page.
  structuredData?: boolean;
}

// Defaults here are a fallback only — every page should pass its own
// title/description (see src/pages/index.astro). Drafted from existing copy
// (src/content/business-lines, src/data/venue.ts) as technical-SEO-reasonable
// defaults; non-blocking for Site Launch, refinable by Christina later
// (wayfinder #17, #20).
const {
  title = `${site.name} | Tulsa, OK Dance Studio & Event Venue`,
  description = `West Coast Swing dance classes, private event rentals, and social dance nights at ${site.name}, ${venue.locationCopy}.`,
  structuredData = true,
} = Astro.props;

// GitHub Pages staging (ADR-0001) must never rank in search over the real
// production site on Cloudflare Pages. The staging deploy workflow
// (.github/workflows/deploy.yml) sets PUBLIC_STAGING=true; Cloudflare Pages
// production leaves it unset, so this only fires on staging builds. A
// noindex meta tag is used (over a disallow-all robots.txt) because it
// reliably deindexes pages that get discovered via inbound links, where a
// robots.txt disallow only blocks crawling and can still leave a bare URL
// indexed with no snippet.
//
// Coming Soon Gate (issue #40): every page in a gated build also gets
// noindex — including in production, and including the secret mirror
// path's pages — as a defense-in-depth backstop behind the mirror being
// unlinked and excluded from the sitemap (astro.config.mjs).
const isStaging = import.meta.env.PUBLIC_STAGING === 'true';
const noindex = isStaging || isGateActive();

// Cloudflare Web Analytics (issue #18) — cookie-less, no consent banner needed.
// The "Promote to Production" workflow (ADR-0004) sets PUBLIC_PRODUCTION=true
// when building for Cloudflare; the GitHub Pages staging workflow
// (.github/workflows/deploy.yml) never sets it, so this is the environment
// signal that distinguishes production from staging.
// PUBLIC_CF_BEACON_TOKEN needs a real beacon token from the Cloudflare
// dashboard before this actually renders anything — see issue #18 for the
// manual setup steps (enable Web Analytics, grab the token, generate the
// shareable read-only link).
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN || '';
const isProductionBuild = Boolean(process.env.PUBLIC_PRODUCTION);
const cfBeaconEnabled = isProductionBuild && cfBeaconToken.length > 0;

// Microsoft Clarity (heatmaps, click tracking, session recordings) — added
// 2026-10-07 because Cloudflare Web Analytics has no custom-event API and
// can't show engagement, only pageviews. Production-only, same reasoning as
// the Cloudflare beacon above: a staging visit (including Claude's own
// preview checks) shouldn't pollute real visitor data. Unlike the Cloudflare
// beacon, Clarity sets cookies — see PrivacyPolicyContent.astro's "Site
// traffic" section, updated alongside this.
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID || '';
const clarityEnabled = isProductionBuild && clarityProjectId.length > 0;

const localBusinessJsonLd = structuredData ? buildLocalBusinessJsonLd() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`.replace('//', '/')} />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`.replace('//', '/')}
    />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      // Self-referencing canonical (Search Console flagged "Duplicate without
      // user-selected canonical" — issue noticed 2026-10-07): without this,
      // Google has no signal to prefer the https://www URL over the bare-HTTP
      // or apex-domain variant that reach the same content.
    }
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
    {
      cfBeaconEnabled && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
        />
      )
    }
    {
      clarityEnabled && (
        <script
          type="text/javascript"
          set:html={`(function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "${clarityProjectId}");`}
        />
      )
    }
    {localBusinessJsonLd && <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/select-enhance';
      import '../scripts/interest-links';
    </script>
  </body>
</html>
