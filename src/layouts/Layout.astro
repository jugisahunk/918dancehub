---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

// Defaults here are a fallback only — every page should pass its own
// title/description (see src/pages/index.astro). Drafted from existing copy
// (src/content/business-lines, src/data/venue.ts) as technical-SEO-reasonable
// defaults; non-blocking for Site Launch, refinable by Christina later
// (wayfinder #17, #20).
const {
  title = `${site.name} | Tulsa, OK Dance Studio & Event Venue`,
  description = `West Coast Swing dance classes, private event rentals, and social dance nights at ${site.name}, Midtown Tulsa Adjacent.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`.replace('//', '/')} />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`.replace('//', '/')}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/select-enhance';
      import '../scripts/interest-links';
    </script>
  </body>
</html>
