---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.shortName} & Events: Dance Classes & Event Rentals in Tulsa, OK`,
  description = 'A dance studio and event venue under one roof in Tulsa, OK. Dance classes, event rentals, and social events. Opening Fall 2026.',
} = Astro.props;

// Cloudflare Web Analytics (issue #18) — cookie-less, no consent banner needed.
// Cloudflare Pages injects CF_PAGES=1 into its own build environment; the
// GitHub Pages staging workflow (.github/workflows/deploy.yml) never sets it,
// so this is the environment signal that already distinguishes production
// from staging without adding a separate flag. Staging noindex is #21.
// PUBLIC_CF_BEACON_TOKEN needs a real beacon token from the Cloudflare
// dashboard before this actually renders anything — see issue #18 for the
// manual setup steps (enable Web Analytics, grab the token, generate the
// shareable read-only link).
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN || '';
const isProductionBuild = Boolean(process.env.CF_PAGES);
const cfBeaconEnabled = isProductionBuild && cfBeaconToken.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`.replace('//', '/')} />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`.replace('//', '/')}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
    {
      cfBeaconEnabled && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
        />
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/select-enhance';
      import '../scripts/interest-links';
    </script>
  </body>
</html>
