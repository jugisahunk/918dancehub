---
import { Image } from 'astro:assets';
import { venue } from '../data/venue';
import venueImage from '../assets/wcs-studio.png';
import VenueGallery from './VenueGallery.astro';
import venueEntryOverview from '../assets/venue/entry-overview.jpg';
import venueAccentLighting from '../assets/venue/accent-lighting-nook.jpg';
import venueTableSeating from '../assets/venue/table-seating.jpg';
import venueDanceFloor from '../assets/venue/dance-floor-wide.jpg';
import venueDressedHero from '../assets/venue/venue-dressed-hero.jpg';
import venueRoomOverview from '../assets/venue/room-overview.jpg';

// Photos of the space dressed for a private rental (wayfinder #13's photo
// pass) — picked for variety of what they show, not near-duplicate angles.
// Ordered as a walk-through: step in through the entry, then the viewer's
// perspective rotates clockwise around the room photo to photo, ending in
// the second event space.
const venuePhotos = [
  { src: venueEntryOverview, alt: 'The dance floor and table seating viewed from just inside the entrance, with the colored accent-light wall and hallway ahead' },
  { src: venueAccentLighting, alt: 'Colored accent lighting and artwork along the wall, with round tables set up nearby' },
  { src: venueTableSeating, alt: "Round tables arranged along the accent-light wall, viewed from the edge of the dance floor" },
  { src: venueDanceFloor, alt: 'Wide view of the polished, empty dance floor ready for a rental event' },
  { src: venueDressedHero, alt: 'The dance floor facing back toward the entrance, with white ceiling draping, round tables, and colored accent lighting' },
  { src: venueRoomOverview, alt: "Round tables set up in the venue's second event space, beneath draped ceiling fabric" },
];
---

<section class="venue-band" id="venue">
  <div class="container venue-two-col">
    <div class="image-frame">
      <div class="image-frame-inner">
        <Image src={venueImage} width={800} height={800} densities={[1, 1.5, 2]} alt="Line-art rendering of the studio's open event floor, viewed through its entry doors" />
      </div>
    </div>
    <div>
      <div class="eyebrow">Event Rentals</div>
      <h2>{venue.description}</h2>
      <p class="body">{venue.locationCopy}</p>
      <p class="amenities">{venue.amenities.join(' · ')}</p>
      <div class="stat-grid">
        {
          venue.stats.map((stat) => (
            <div class="stat-tile">
              <div class="stat-value">
                {stat.value}
                {stat.pending && <span class="pending-mark" title="Placeholder, pending real figures (wayfinder #13)">*</span>}
              </div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
      <p class="pending-note">* Figures still being finalized.</p>
      <div class="event-types">
        <div class="event-types-label">A few of the events we host</div>
        <ul>
          {venue.eventTypes.map((type) => <li>{type}</li>)}
        </ul>
        <p class="event-types-note">{venue.eventTypesNote}</p>
      </div>
      <a href="#contact" class="cta-pill" data-interest="Event Rental">Check Availability</a>
      <p class="tour-note">{venue.pricingNote}</p>
    </div>
  </div>
  <div class="container venue-gallery-block">
    <VenueGallery photos={venuePhotos} />
  </div>
</section>

<style>
  .venue-band {
    padding: 3rem 0;
  }

  .venue-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .venue-gallery-block {
    margin-top: 2.5rem;
  }

  .image-frame {
    border-radius: 18px;
    padding: 1px;
    border: 1px solid var(--gold);
    height: clamp(240px, 55vw, 460px);
    min-width: 0;
  }

  .image-frame-inner {
    width: 100%;
    height: 100%;
    border-radius: 17px;
    overflow: hidden;
  }

  .image-frame-inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    margin: 1rem 0 1.5rem;
    line-height: 1.6;
  }

  .amenities {
    font-size: 0.82rem;
    color: var(--teal-light);
    margin: -0.75rem 0 1.5rem;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .stat-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: var(--gold-light);
  }

  .pending-mark {
    color: var(--teal-light);
    font-size: 1rem;
  }

  .stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--text-4);
  }

  .pending-note {
    font-size: 0.78rem;
    color: var(--text-5);
    margin: 0 0 1.5rem;
  }

  .event-types {
    margin-bottom: 1.5rem;
  }

  .event-types-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--teal);
    margin-bottom: 0.6rem;
  }

  .event-types ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.6rem;
  }

  .event-types li {
    font-size: 0.82rem;
    color: var(--text-2);
    text-align: center;
    border: 1px solid var(--hairline-neutral);
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
  }

  .event-types-note {
    font-size: 0.82rem;
    color: var(--text-3);
    margin: 0.75rem 0 0;
  }

  .tour-note {
    font-size: 0.82rem;
    color: var(--text-4);
    margin: 0.75rem 0 0;
  }

  @media (min-width: 768px) {
    .venue-two-col {
      grid-template-columns: 1fr 1fr;
    }

    .stat-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
