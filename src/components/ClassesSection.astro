---
import { getCollection, getEntry } from 'astro:content';

const classes = await Promise.all(
  (await getCollection('classes'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (c) => ({ ...c, instructor: await getEntry(c.data.instructor) }))
);

// Grouped by day so pricing (which describes the whole night — both
// lessons plus the practice dance) is shown once per day, not per row.
const dayOrder: string[] = [];
const byDay = new Map<string, typeof classes>();
for (const c of classes) {
  if (!byDay.has(c.data.day)) {
    byDay.set(c.data.day, []);
    dayOrder.push(c.data.day);
  }
  byDay.get(c.data.day)!.push(c);
}
const dayGroups = dayOrder.map((day) => {
  const items = byDay.get(day)!;
  const pricing = items.map((i) => i.data.pricing).find(Boolean);
  return { day, items, pricing };
});
---

<section class="classes-band" id="classes">
  <div class="container classes-two-col">
    <div>
      <div class="eyebrow">Dance Classes</div>
      <h2>All levels. All styles. No partner required.</h2>
      <p class="body">
        West Coast Swing for every level, taught by instructors who love teaching as much as
        dancing. No partner required.
      </p>
      <a href="#contact" class="cta-outline" data-interest="Dance Class">Ask About Classes</a>
    </div>
    <div class="schedule-list">
      {
        dayGroups.map(({ day, items, pricing }) => (
          <div class="day-group">
            <div class="day-label">{day}</div>
            {items.map((c) => (
              <div class="schedule-row">
                <div class="schedule-row-top">
                  <div class="class-name">{c.data.name}</div>
                  <div class="class-time">{c.data.schedule}</div>
                </div>
                <div class="class-level">
                  {c.data.level} &middot; {c.instructor.data.name}
                </div>
              </div>
            ))}
            {pricing && <div class="day-pricing">{pricing}</div>}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .classes-band {
    padding: 3rem 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: radial-gradient(120% 80% at 50% 0%, rgba(212, 175, 55, 0.07), transparent 60%);
  }

  .classes-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .body {
    margin: 1rem 0 1.5rem;
    line-height: 1.6;
  }

  .schedule-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .day-group {
    border-left: 3px solid var(--teal);
    padding-left: 0.9rem;
  }

  .day-group:nth-of-type(even) {
    border-left-color: var(--gold);
  }

  .day-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--teal-light);
    margin-bottom: 0.2rem;
  }

  .day-group:nth-of-type(even) .day-label {
    color: var(--gold-light);
  }

  .schedule-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.6rem 0.75rem;
    border-radius: 12px;
    transition: background 0.2s ease;
  }

  .schedule-row:hover {
    background: rgba(42, 168, 163, 0.08);
  }

  .schedule-row + .schedule-row {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .day-pricing {
    margin: 0.5rem 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--gold-grad);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .schedule-row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .class-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-2);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .class-level {
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--text-4);
  }

  .class-time {
    color: var(--teal-light);
    white-space: nowrap;
    font-size: 0.9rem;
  }

  @media (min-width: 768px) {
    .classes-two-col {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
