---
// The real homepage's section list, extracted (issue #38) so it renders
// identically at the root path and, in a later ticket, at the Coming Soon
// Gate's secret mirror path — defined once instead of duplicated by hand.
import Header from './Header.astro';
import Hero from './Hero.astro';
import FeatureGrid from './FeatureGrid.astro';
import MissionSection from './MissionSection.astro';
import ClassesSection from './ClassesSection.astro';
import VenueSection from './VenueSection.astro';
import EventsSection from './EventsSection.astro';
import TeachSection from './TeachSection.astro';
import ContactSection from './ContactSection.astro';
import Footer from './Footer.astro';
import BottomNav from './BottomNav.astro';

interface Props {
  // Coming Soon Gate mirror (issue #39): the path segment this instance is
  // rendered under (e.g. `/wooshywooshy`), threaded down to ContactSection
  // so its Inquiry form redirects within the same mirror. Empty string at
  // the real root path.
  basePath?: string;
}

const { basePath = '' } = Astro.props;
---

<Header />
<main>
  <Hero />
  <FeatureGrid />
  <MissionSection />
  <ClassesSection />
  <VenueSection />
  <EventsSection />
  <TeachSection />
  <ContactSection basePath={basePath} />
</main>
<Footer />
<BottomNav />
