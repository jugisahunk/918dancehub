---
import { Image } from 'astro:assets';
import { mission } from '../data/mission';
import heroImage from '../assets/wcs-silhouette-2.png';

interface Props {
  // Coming Soon Gate splash (issue #38) reuses this component verbatim but
  // without CTAs, since their target sections don't exist on that page.
  showCtas?: boolean;
}

const { showCtas = true } = Astro.props;
---

<section class="hero-band" id="top">
  <div class="container hero-two-col">
    <div>
      <div class="hero-badge">Opening Fall 2026 &middot; Tulsa</div>
      <h1 class="hero-h1">Where moves<br /><span class="script accent">create memories</span></h1>
      <p class="hero-sub">{mission.heroLine}</p>
      {
        showCtas && (
          <div class="hero-ctas">
            <a href="#classes" class="cta-pill">See Class Schedule</a>
            <a href="#venue" class="cta-outline">Rent the Venue</a>
          </div>
        )
      }
    </div>
    <div class="image-frame">
      <div class="image-frame-inner">
        <Image src={heroImage} width={800} height={800} densities={[1, 1.5, 2]} alt="Silhouette of two dancers connected hand-to-hand mid-pattern, West Coast Swing style" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-band {
    padding: 3.5rem 0;
  }

  .hero-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border: 1px solid var(--teal);
    border-radius: 999px;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--teal-light);
    margin-bottom: 1.2rem;
  }

  .hero-h1 {
    font-size: clamp(2.4rem, 9vw, 4.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero-h1 .accent {
    font-weight: 400;
    font-size: 1.15em;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    max-width: 46ch;
    margin: 1.2rem 0 1.8rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .image-frame {
    border-radius: 20px;
    padding: 10px;
    background: var(--gold-grad);
    height: clamp(260px, 60vw, 520px);
    min-width: 0;
  }

  .image-frame-inner {
    width: 100%;
    height: 100%;
    border-radius: 14px;
    background: var(--bg-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .image-frame-inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .hero-two-col {
      text-align: center;
    }

    .hero-ctas {
      justify-content: center;
    }
  }

  @media (min-width: 768px) {
    .hero-two-col {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
