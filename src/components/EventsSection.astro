---
import { getCollection } from 'astro:content';

const events = (await getCollection('socialEvents')).sort((a, b) => a.data.order - b.data.order);
---

<section class="events-band" id="events">
  <div class="container">
    <div class="eyebrow">Social Events</div>
    <h2>Dance. Connect. Make memories.</h2>
    <div class="event-grid">
      {
        events.map((event) => (
          <div class="event-card">
            <div class="event-image" aria-hidden="true">
              <svg width="100%" height="100%" viewBox="0 0 300 170" preserveAspectRatio="xMidYMid slice">
                <rect width="300" height="170" fill="var(--bg-deep)" />
                <g fill="none" stroke="var(--gold-light)" stroke-width="1.6" stroke-linecap="round" opacity=".8">
                  <circle cx="110" cy="60" r="10" />
                  <path d="M110 70 L110 110" />
                  <path d="M110 82 L85 100" />
                  <path d="M110 82 L135 92" />
                </g>
                <g fill="none" stroke="var(--teal)" stroke-width="1.6" stroke-linecap="round" opacity=".8">
                  <circle cx="165" cy="66" r="10" />
                  <path d="M165 76 L165 116" />
                  <path d="M165 88 L190 104" />
                  <path d="M165 88 L140 92" />
                </g>
              </svg>
            </div>
            <div class="event-body">
              <div class="event-date">{event.data.recurrence}</div>
              <h3>{event.data.name}</h3>
              <p>{event.data.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .events-band {
    padding: 3rem 0;
    border-top: 1px solid var(--hairline);
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.05), transparent);
  }

  h2 {
    margin: 0.5rem 0 2rem;
  }

  .event-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .event-card {
    border: 1px solid var(--hairline);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .event-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
  }

  .event-image {
    height: 170px;
  }

  .event-body {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .event-date {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 0.4rem;
  }

  .event-body h3 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .event-body p {
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  @media (min-width: 768px) {
    .event-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .event-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
