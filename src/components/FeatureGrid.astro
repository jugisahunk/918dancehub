---
import { getCollection } from 'astro:content';

const lines = (await getCollection('businessLines')).sort((a, b) => a.data.order - b.data.order);

// Line-art icons (prototype variant C, wayfinder #9), keyed by card title.
const icons: Record<string, string> = {
  'Dance Classes':
    '<path d="M6 4c-1.5 0-2.2 1.5-1.5 3 .7 1.5 3 1.5 3.5 0 .5-1.5-.5-3-2-3z"/><path d="M6 8v6l3 2"/>',
  'Event Rentals': '<path d="M4 16V8l6-4 6 4v8"/><path d="M8 16v-5h4v5"/>',
  'Social Events': '<circle cx="10" cy="6" r="2"/><path d="M4 17c1-4 4-6 6-6s5 2 6 6"/>',
  'A Community':
    '<circle cx="7" cy="6" r="2"/><circle cx="13" cy="6" r="2"/><path d="M3 16c.5-3 2.2-5 4-5s3.5 2 4 5"/><path d="M9 16c.5-3 2.2-5 4-5s3.5 2 4 5"/>',
};
---

<section class="features">
  <div class="container feature-grid">
    {
      lines.map((line) => (
        <div class="feature-card">
          <div class="feature-mark" set:html={`<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">${icons[line.data.title] ?? ''}</svg>`} />
          <div class="feature-title">{line.data.title}</div>
          <div class="feature-body">{line.data.body}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    padding: 3rem 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .feature-card {
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 1.5rem 1.35rem;
    background: var(--surface-grad);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
  }

  .feature-mark {
    width: 44px;
    height: 44px;
    border: 1px solid var(--teal);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.9rem;
    color: var(--teal-light);
  }

  .feature-title {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold-light);
    margin-bottom: 0.5rem;
  }

  .feature-body {
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (min-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
