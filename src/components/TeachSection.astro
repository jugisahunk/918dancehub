<section class="teach-band" id="teach">
  <div class="container">
    <div class="teach-panel">
      <div class="eyebrow">Now Hiring</div>
      <h2>We're looking for dance instructors of all types</h2>
      <p class="body">
        918 Dance Hub & Events is building a vibrant community and we want you to be a part of it.
        All styles welcome, flexible schedules, and room to grow your brand.
      </p>
      <a href="#contact" class="cta-pill" data-interest="Teach With Us">Apply to Teach</a>
      <p class="script closing">Inspire. Teach. Connect.</p>
    </div>
  </div>
</section>

<style>
  .teach-band {
    padding: 3rem 0;
  }

  .teach-panel {
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 20px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    background: radial-gradient(100% 120% at 50% 0%, rgba(42, 168, 163, 0.12), rgba(255, 255, 255, 0.02));
  }

  .body {
    max-width: 56ch;
    margin: 1rem auto 1.5rem;
    line-height: 1.6;
  }

  .closing {
    margin: 1.5rem 0 0;
    font-size: 1.6rem;
    color: var(--gold-light);
  }
</style>
