---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="venue-gallery">
  <div class="gallery-grid">
    {
      photos.map((photo, index) => (
        <button type="button" class="gallery-thumb" data-gallery-index={index} aria-label={`View larger: ${photo.alt}`}>
          <Image src={photo.src} alt={photo.alt} width={480} height={360} densities={[1, 1.5, 2]} />
        </button>
      ))
    }
  </div>

  <dialog class="gallery-dialog" id="venue-gallery-dialog" aria-label="Enlarged venue photo">
    <button type="button" class="gallery-close" data-gallery-close aria-label="Close enlarged photo">&times;</button>
    {
      photos.map((photo, index) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          width={1600}
          height={1200}
          densities={[1, 1.5, 2]}
          class="gallery-full"
          data-gallery-full={index}
          hidden={index !== 0}
        />
      ))
    }
  </dialog>
</div>

<script>
  const dialog = document.getElementById('venue-gallery-dialog') as HTMLDialogElement | null;
  const gallery = document.querySelector('.venue-gallery');
  if (dialog && gallery) {
    const fullImages = Array.from(dialog.querySelectorAll<HTMLElement>('[data-gallery-full]'));

    gallery.querySelectorAll<HTMLElement>('[data-gallery-index]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = thumb.dataset.galleryIndex;
        fullImages.forEach((img) => {
          img.hidden = img.dataset.galleryFull !== index;
        });
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());

    // Click on the backdrop (the dialog element itself, outside its content) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }

  .gallery-thumb {
    display: block;
    padding: 0;
    border: 1px solid var(--hairline-neutral);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
    aspect-ratio: 4 / 3;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .gallery-thumb:hover,
  .gallery-thumb:focus-visible {
    transform: translateY(-3px);
    border-color: var(--gold);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
  }

  .gallery-thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-dialog {
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 16px;
    background: var(--bg-deep);
    max-width: min(92vw, 1100px);
    max-height: 90vh;
  }

  .gallery-dialog::backdrop {
    background: rgba(0, 0, 0, 0.75);
  }

  .gallery-dialog :global(img[hidden]) {
    display: none;
  }

  .gallery-dialog :global(img:not([hidden])) {
    display: block;
    max-width: min(92vw, 1100px);
    max-height: 90vh;
    width: auto;
    height: auto;
  }

  .gallery-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--bg-deep);
    color: var(--text-2);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery-close:hover,
  .gallery-close:focus-visible {
    border-color: var(--gold);
    color: var(--gold-light);
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
