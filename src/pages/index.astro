---
import Layout from '../layouts/Layout.astro';
import HomeContent from '../components/HomeContent.astro';
import ComingSoonSplash from '../components/ComingSoonSplash.astro';
import { site } from '../data/site';
import { venue } from '../data/venue';
import { COMING_SOON_GATE } from '../data/gate';

// Coming Soon Gate (issue #37/#38): only the two CI-driven builds honor the
// flag — PUBLIC_STAGING (deploy.yml) and PUBLIC_PRODUCTION (promote-
// production.yml), the same signals Layout.astro/astro.config.mjs already
// use to tell staging/production apart from local dev. `astro dev` and a
// local `npm run build` never set either, so they always show the real
// homepage regardless of the flag's committed value.
const isStaging = import.meta.env.PUBLIC_STAGING === 'true';
const isProductionBuild = Boolean(process.env.PUBLIC_PRODUCTION);
const gateActive = COMING_SOON_GATE && (isStaging || isProductionBuild);

// Home page's own title/description — see the Layout default comment for
// where this copy is drafted from. Kept explicit here (rather than relying
// on the Layout default) so additional pages have a clear pattern to follow.
const title = `${site.name} | Tulsa, OK Dance Studio & Event Venue`;
const description = `West Coast Swing dance classes, private event rentals, and social dance nights at ${site.name}, ${venue.locationCopy}.`;
---

<Layout title={title} description={description} structuredData={!gateActive}>
  {gateActive ? <ComingSoonSplash /> : <HomeContent />}
</Layout>
