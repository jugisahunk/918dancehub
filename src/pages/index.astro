---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import MissionSection from '../components/MissionSection.astro';
import ClassesSection from '../components/ClassesSection.astro';
import VenueSection from '../components/VenueSection.astro';
import EventsSection from '../components/EventsSection.astro';
import TeachSection from '../components/TeachSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';

// Home page's own title/description — see the Layout default comment for
// where this copy is drafted from. Kept explicit here (rather than relying
// on the Layout default) so additional pages have a clear pattern to follow.
const title = `${site.name} | Tulsa, OK Dance Studio & Event Venue`;
const description = `West Coast Swing dance classes, private event rentals, and social dance nights at ${site.name}, Midtown Tulsa Adjacent.`;
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <FeatureGrid />
    <MissionSection />
    <ClassesSection />
    <VenueSection />
    <EventsSection />
    <TeachSection />
    <ContactSection />
  </main>
  <Footer />
  <BottomNav />
</Layout>
