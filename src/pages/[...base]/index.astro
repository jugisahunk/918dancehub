---
// Homepage — built at both `/` and, while the Coming Soon Gate is on, the
// secret mirror path (issue #39). `[...base]` is a rest param matched to
// zero segments for `/` (see getStaticPaths below) — this one file decides
// both instances so root/mirror can't drift apart — there's exactly one
// place that says which path gets the splash and which gets the real
// homepage.
//
// Ungated: only `/` exists, and it's always the real homepage.
// Gated: `/` gets the splash, and `/{SECRET_PATH}/` gets the real homepage
// — the mirror path only exists at all while gated.
import Layout from '../../layouts/Layout.astro';
import HomeContent from '../../components/HomeContent.astro';
import ComingSoonSplash from '../../components/ComingSoonSplash.astro';
import { site } from '../../data/site';
import { venue } from '../../data/venue';
import { SECRET_PATH, isGateActive } from '../../data/gate';

export function getStaticPaths() {
  const paths = [{ params: { base: undefined } }];
  if (isGateActive()) {
    paths.push({ params: { base: SECRET_PATH } });
  }
  return paths;
}

const isMirror = Astro.params.base === SECRET_PATH;
const showSplash = isGateActive() && !isMirror;
const basePath = isMirror ? `/${SECRET_PATH}` : '';

// Home page's own title/description — see the Layout default comment for
// where this copy is drafted from. Kept explicit here (rather than relying
// on the Layout default) so additional pages have a clear pattern to follow.
const title = `${site.name} | Tulsa, OK Dance Studio & Event Venue`;
const description = `West Coast Swing dance classes, private event rentals, and social dance nights at ${site.name}, ${venue.locationCopy}.`;
---

<Layout title={title} description={description} structuredData={!showSplash}>
  {showSplash ? <ComingSoonSplash /> : <HomeContent basePath={basePath} />}
</Layout>
